{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "bls-oews": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "bls-oews-mcp==1.0.6", "bls-oews-mcp"],
      "env": {"FEDERAL_API_MIN_INTERVAL_SECONDS": "3"}
    },
    "gsa-calc": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "gsa-calc-mcp==1.0.4", "gsa-calc-mcp"],
      "env": {"FEDERAL_API_MIN_INTERVAL_SECONDS": "3"}
    },
    "gsa-perdiem": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "gsa-perdiem-mcp==1.0.6", "gsa-perdiem-mcp"],
      "env": {"FEDERAL_API_MIN_INTERVAL_SECONDS": "4"}
    }
  }
}
