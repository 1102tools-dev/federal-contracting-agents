{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "sam-gov": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "sam-gov-mcp==1.0.11", "sam-gov-mcp"],
      "env": {"FEDERAL_API_MIN_INTERVAL_SECONDS": "3", "MCP_ACCESS_STATUS_VERSION": "1"}
    },
    "usaspending": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "usaspending-gov-mcp==1.0.4", "usaspending-mcp"],
      "env": {"FEDERAL_API_MIN_INTERVAL_SECONDS": "3", "USASPENDING_TOOL_PROFILE": "acquisition-agent"}
    },
    "gsa-calc": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "gsa-calc-mcp==1.0.4", "gsa-calc-mcp"],
      "env": {"FEDERAL_API_MIN_INTERVAL_SECONDS": "3"}
    },
    "tavily-web": {
      "type": "streamable-http",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {"X-Tavily-Access-Mode": "keyless"}
    }
  }
}
