      "version": "1.0.0-rc.8"
    },
    {
      "id": "acquisition-policy-agent",
      "version": "1.0.0-rc.4"
    }
  ],
  "lifecycle_lanes": [
    "install",
    "upgrade",
    "reinstall",
    "uninstall",
    "restore",
    "credentials",
    "resume",
    "concurrency",
    "drift",
    "long-session"
  ],
  "upgrade_fixture": {
    "from": {
      "marketplace_tag": "v1.2.0-rc.4",
      "versions": {
        "market-research-agent": "1.0.0-rc.4",
        "pre-award-agent": "1.0.0-rc.4",
        "govcon-growth-agent": "1.0.0-rc.3",
