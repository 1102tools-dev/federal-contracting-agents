{
  "schema_version": "1.0",
  "release_candidate": "v1.2.0-rc.15",
  "repository": "1102tools-dev/federal-contracting-agents",
  "source_ref": "main",
  "clients": {
    "codex": {
      "marketplace": "1102tools",
      "marketplace_add": [
        "codex",
        "plugin",
        "marketplace",
        "add",
        "1102tools-dev/federal-contracting-agents",
        "--ref",
        "main"
      ],
      "install_subcommand": "add",
      "remove_subcommand": "remove",
      "marketplace_refresh": "upgrade",
      "plugin_update": "remove-add"
    },
    "claude": {
      "marketplace": "1102tools",
      "marketplace_add": [
        "claude",
        "plugin",
        "marketplace",
        "add",
        "1102tools-dev/federal-contracting-agents"
      ],
      "install_subcommand": "install",
      "remove_subcommand": "uninstall",
      "marketplace_refresh": "update",
      "plugin_update": "update"
    }
  },
  "agents": [
    {
      "id": "market-research-agent",
      "version": "1.0.0-rc.12"
    },
    {
      "id": "pre-award-agent",
      "version": "1.0.0-rc.8"
    },
    {
      "id": "govcon-growth-agent",
      "version": "1.0.0-rc.10"
    },
    {
